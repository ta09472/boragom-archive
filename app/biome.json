{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.css",
      "vite.config.ts"
    ],
    "ignoreUnknown": true
  },
  "formatter": { "enabled": true, "indentStyle": "space" },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "useMediaCaption": "off" },
      "security": { "noDangerouslySetInnerHtml": "off" },
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
